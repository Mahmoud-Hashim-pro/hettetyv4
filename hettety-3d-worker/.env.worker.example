# ==============================================================================
# HETTETY 3D GPU Worker — Environment Configuration Example
# ==============================================================================

# Node/Application Environment ('production' enforces strict secrets and real endpoints)
NODE_ENV=production
HETTETY_ENV=production

# Worker Unique Identifier
HETTETY_WORKER_ID=hettety-gpu-worker-node-1

# Control Plane Webhook & Security (Mandatory in production)
# Worker sends stage progress and publish promotions to this endpoint
HETTETY_CONTROL_PLANE_URL=https://api.hettety.com/api/reconstruction?action=worker-callback
WORKER_SHARED_SECRET=your_secure_worker_shared_secret_here

# Redis Queue Connection
REDIS_URL=redis://redis:6379/0
REDIS_STREAM_KEY=hettety:3d:reconstruction_jobs
REDIS_CONSUMER_GROUP=hettety_gpu_workers

# Storage Provider Configuration ('gcs', 's3', or 'local')
STORAGE_PROVIDER=gcs
HETTETY_STORAGE_BUCKET=hettety-spatial-assets
GOOGLE_APPLICATION_CREDENTIALS=/app/credentials/gcp-service-account.json

# Local Workspace Directory
HETTETY_WORK_DIR=/tmp/hettety_3d
HETTETY_CDN_BASE_URL=https://storage.googleapis.com/hettety-spatial-assets

# Hardware Overrides
# Set to 'true' to force CPU SfM fallback (for testing without NVIDIA GPU)
COLMAP_FORCE_CPU=false
