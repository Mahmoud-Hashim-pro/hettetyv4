# ─────────────────────────────────────────────────────────────────────────────
# HETTETY v4 — Server-Side Environment Configuration
# Copy this file to `.env` locally or configure in Vercel Project Settings.
# Never prefix server secrets with VITE_ (Vite exposes VITE_* to the browser).
# ─────────────────────────────────────────────────────────────────────────────

# =============================================================================
# 1. Neon Serverless PostgreSQL (Primary Relational Database & Rate Limiter)
# =============================================================================
# Pooled Neon connection string (required in production for DB, Auth & AI rate limiting)
DATABASE_URL="postgresql://neondb_owner:PASSWORD@ep-example-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# HMAC-SHA256 signing secret for Neon JWT auth sessions (generate >= 32 random bytes)
AUTH_JWT_SECRET="replace-with-at-least-32-random-hex-bytes"

# =============================================================================
# 2. Native Neon Object Storage (S3-Compatible — Images, 360°, 3DGS .spz & .glb)
# =============================================================================
# Copy these directly from Neon Console -> Connect -> Storage -> .env
NEON_STORAGE_BUCKET="assets"
AWS_ENDPOINT_URL_S3="https://<your-neon-storage-endpoint>"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="eu-central-1"

# Optional fallback providers (Cloudflare R2 / Google Cloud Storage / Vercel Blob)
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET="hettety-spatial-assets"
# GCS_BUCKET_NAME="hettety-spatial-assets"
# BLOB_READ_WRITE_TOKEN=""

# =============================================================================
# 3. AI Real Estate Advisor & Per-Task Provider Routing (/api/ai)
# =============================================================================
# Which vendor /api/ai talks to:
# gemini (default) | groq | openai | nvidia | openrouter | together
AI_PROVIDER="gemini"

# Provider API keys (set the key matching AI_PROVIDER and any task overrides)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# GROQ_API_KEY="gsk_..."
# OPENAI_API_KEY="sk-..."
# NVIDIA_API_KEY="nvapi-..."
# OPENROUTER_API_KEY="sk-or-..."
# TOGETHER_API_KEY="..."

# Model defaults & resilient fallback
AI_MODEL="gemini-2.5-flash"
AI_FALLBACK_MODEL="gemini-2.0-flash"

# Optional per-task overrides (chat | search | describe | brochure | ocr)
# AI_TASK_CHAT_PROVIDER="gemini"
# AI_TASK_CHAT_MODEL="gemini-2.5-flash"
# AI_TASK_SEARCH_PROVIDER="groq"
# AI_TASK_SEARCH_MODEL="llama-3.3-70b-versatile"
# AI_TASK_BROCHURE_PROVIDER="gemini"   # Keep on Gemini for inline PDF support

# Optional custom OpenAI-compatible gateway (vLLM, DeepInfra, Ollama, etc.)
# AI_BASE_URL="https://your-gateway/v1"
# AI_API_KEY="..."

# =============================================================================
# 4. Distributed Rate Limiter, Escrow Webhooks & 3D GPU Worker Control Plane
# =============================================================================
# Optional Redis URL. When omitted, Neon Postgres (`rate_limit_buckets`)
# automatically powers atomic multi-tier distributed rate limiting in production!
# REDIS_URL="rediss://default:password@my-redis-host:6379"
# RATE_LIMIT_FAIL_CLOSED="true"

# Shared secret authenticating GPU 3D reconstruction workers
# WORKER_SHARED_SECRET="replace-with-32-char-worker-secret"

# HMAC-SHA256 webhook verification secret for CBE bank escrow confirmations
# ESCROW_WEBHOOK_SECRET="replace-with-bank-webhook-hmac-secret"

# =============================================================================
# 5. Public App URL & Legacy Firebase Compatibility (Optional)
# =============================================================================
APP_URL="https://hettety.vercel.app"
# FIRESTORE_DATABASE_ID="ai-studio-7dc9cb2d-ccba-48fa-8d31-f2b7a4759743"
# FIREBASE_PROJECT_ID="gen-lang-client-0748002195"
# FIREBASE_SERVICE_ACCOUNT_KEY=""
