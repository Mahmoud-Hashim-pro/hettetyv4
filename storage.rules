rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Storage rules cannot read Firestore, so role-based admins are NOT covered
    // here — only these accounts. Must stay in sync with isSuperAdmin() in
    // firestore.rules and SUPER_ADMIN_EMAILS in src/constants.ts.
    function isSuperAdmin() {
      return isAuthenticated() &&
        (request.auth.token.email == "marwaneltaweel0@gmail.com" ||
         request.auth.token.email == "abdallahahmedpilot2426@gmail.com" ||
         request.auth.token.email == "pro.mahmoud.h@gmail.com" ||
         request.auth.token.email == "modyhashim2006@gmail.com");
    }

    // Property media — any authenticated user may upload:
    //  • images  (≤ 15MB)
    //  • videos  (≤ 80MB) — property tour clips
    //  • PDFs    (≤ 15MB) — legal documents (contract / registry)
    // Object names are timestamp+random, so clobbering someone else's file is
    // effectively impossible.
    // New uploads are namespaced by uploader uid so an owner deleting their own
    // listing can clean up its media. Without the uid segment there is nothing for
    // a rule to check.
    // Confidential property legal documents (deeds, contracts, certificates):
    // Restricted strictly to the property owner and super-admins.
    match /properties/{ownerUid}/legal/{fileName} {
      allow read: if isOwner(ownerUid) || isSuperAdmin();
      allow create: if isOwner(ownerUid) && (
                     (request.resource.contentType == 'application/pdf' && request.resource.size < 15 * 1024 * 1024) ||
                     (request.resource.contentType.matches('image/.*') && request.resource.size < 15 * 1024 * 1024)
                   );
      allow update: if false;
      allow delete: if isOwner(ownerUid) || isSuperAdmin();
    }

    // Property media — any authenticated user may upload:
    //  • images  (≤ 15MB)
    //  • videos  (≤ 80MB) — property tour clips
    //  • PDFs    (≤ 15MB) — public property brochures
    match /properties/{ownerUid}/{fileName} {
      allow read: if true;
      allow create: if isOwner(ownerUid) && (
                     (request.resource.contentType.matches('image/.*') && request.resource.size < 15 * 1024 * 1024) ||
                     (request.resource.contentType.matches('video/.*') && request.resource.size < 80 * 1024 * 1024) ||
                     (request.resource.contentType == 'application/pdf' && request.resource.size < 15 * 1024 * 1024)
                   );
      allow update: if false;
      allow delete: if isOwner(ownerUid) || isSuperAdmin();
    }

    // 3D Spatial Captures (Raw input images & videos):
    // Private by default. Read restricted to super-admins / backend worker.
    // Client write is strictly size-capped and type-validated without overwrite.
    match /properties/{propertyId}/3d/raw/{jobId}/{fileName} {
      allow read: if isSuperAdmin();
      allow create: if isAuthenticated() && (
                     (request.resource.contentType.matches('image/.*') && request.resource.size < 50 * 1024 * 1024) ||
                     (request.resource.contentType.matches('video/.*') && request.resource.size < 500 * 1024 * 1024)
                    );
      allow update: if false;
      allow delete: if isSuperAdmin();
    }

    // Published 3D Spatial Assets (scene.spz, mesh.glb, manifest.json):
    // Publicly readable for 3D property tour viewer.
    // Writes strictly forbidden to clients (backend worker / Admin SDK only).
    match /properties/{propertyId}/tour/{fileName} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Immutable versioned attempt artifacts:
    // Publicly readable for property preview, writes strictly forbidden to clients.
    match /properties/{propertyId}/3d/{jobId}/{attemptId}/{fileName} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Legacy flat objects: still readable, never writable or deletable from a
    // client. Media uploaded before the uid segment existed has to be swept with
    // the Admin SDK — the app tells the owner so instead of pretending it's gone.
    match /properties/{fileName} {
      allow read: if true;
      // Create only (no overwrite of an existing object), typed and size-capped.
      // Object names are timestamp+random so accidental collisions are impossible.
      allow create: if isAuthenticated() && (
                     (request.resource.contentType.matches('image/.*') && request.resource.size < 15 * 1024 * 1024) ||
                     (request.resource.contentType.matches('video/.*') && request.resource.size < 80 * 1024 * 1024) ||
                     (request.resource.contentType == 'application/pdf' && request.resource.size < 15 * 1024 * 1024)
                   );
      // No client can overwrite or delete — stops any signed-in user wiping the
      // shared prefix. The app never deletes Storage objects from the client;
      // cleanup is done via the Admin SDK / console.
      allow update, delete: if false;
    }

    // Match user documents
    match /user_documents/{userId}/{fileName} {
      // The owner, plus a reviewer who has to open the file to review it.
      allow read: if isOwner(userId) || isSuperAdmin();
      allow create, update: if isOwner(userId)
                   // Limit file size to 5MB
                   && request.resource.size < 5 * 1024 * 1024
                   // Only allow specific content types (PDFs, Images)
                   && request.resource.contentType.matches('application/pdf|image/.*');
      allow delete: if isOwner(userId);
    }
    
    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
