# ─────────────────────────────────────────────────────────────────────────────
# SERVER-SIDE ONLY. These are read by the /api/ai serverless function.
# They are NOT prefixed with VITE_, so Vite never exposes them to the browser —
# the model key is no longer baked into the JS bundle.
#
# On Vercel: Project → Settings → Environment Variables (then redeploy).
# Locally:   copy this file to `.env` (git-ignored) and run `npm run dev`.
# ─────────────────────────────────────────────────────────────────────────────

# Which vendor /api/ai talks to.
# gemini (default) | nvidia | openrouter | together | groq | openai
AI_PROVIDER="gemini"

# --- Provider keys: set the one matching AI_PROVIDER ---
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# NVIDIA_API_KEY="nvapi-..."
# OPENROUTER_API_KEY="sk-or-..."
# TOGETHER_API_KEY="..."
# GROQ_API_KEY="gsk_..."
# OPENAI_API_KEY="sk-..."

# ─────────────────────────────────────────────────────────────────────────────
# PER-TASK ROUTING (optional) — use several providers at once.
# Each task falls back to AI_PROVIDER above if not set. If a task's provider is
# missing or can't handle the input (e.g. a PDF), /api/ai automatically routes to
# one that can rather than failing.
#
#   chat      conversational assistant   (Arabic quality + speed matter)
#   search    natural language -> JSON    (cheap + structured; a small model is fine)
#   describe  listing description writer  (Arabic quality)
#   brochure  brochure import             (MUST accept PDF -> keep this on gemini)
#   ocr       registry number from a deed (image input is enough)
#
# Example: fast free chat on Groq, cheap search on NVIDIA, PDFs on Gemini.
# AI_TASK_CHAT_PROVIDER="groq"
# AI_TASK_CHAT_MODEL="llama-3.3-70b-versatile"
# AI_TASK_SEARCH_PROVIDER="nvidia"
# AI_TASK_SEARCH_MODEL="deepseek-ai/deepseek-v4-flash-0731"
# AI_TASK_OCR_PROVIDER="nvidia"
# AI_TASK_OCR_MODEL="meta/muse-glimmer-30b"
# AI_TASK_BROCHURE_PROVIDER="gemini"   # PDF support
# ─────────────────────────────────────────────────────────────────────────────

# --- Optional overrides ---
# Model to use. Each provider has a sensible default (Gemini: gemini-3.6-flash).
# NOTE: gemini-2.5-flash is closed to newly created API keys.
# AI_MODEL="gemini-3.6-flash"
# Optional: retried once when the primary model is overloaded. Leave unset unless
# you know the key can access this model, or an overload becomes a 404.
# AI_FALLBACK_MODEL=""

# Any other OpenAI-compatible gateway (DeepInfra, vLLM, Ollama, …):
# set these two and AI_PROVIDER can be any name.
# AI_BASE_URL="https://your-gateway/v1"
# AI_API_KEY="..."

# NOTE ON MULTIMODAL INPUT: the brochure importer sends PDFs. Gemini accepts PDFs
# inline; OpenAI-compatible gateways generally accept images only, so /api/ai
# returns a clear 415 in that case. Keep AI_PROVIDER=gemini if you rely on PDF
# brochure import.

# ─────────────────────────────────────────────────────────────────────────────
# Cloud Functions (functions/index.js — the email-alert function)
# ─────────────────────────────────────────────────────────────────────────────
# Public site URL used for links inside outgoing emails (no trailing slash).
APP_URL="https://hettety.vercel.app"

# Firebase Storage bucket, e.g. my-project.firebasestorage.app
# Optional but recommended: /api/ai will fetch a brochure the browser staged in
# Storage (so a 15MB PDF works despite the ~4.5MB request-body cap). Setting this
# pins that fetch to your own bucket instead of any public Firebase file.
STORAGE_BUCKET=

# ─────────────────────────────────────────────────────────────────────────────
# Database & Control Plane Settings
# ─────────────────────────────────────────────────────────────────────────────
# Named Firestore database ID (must match firebase-applet-config.json and functions/index.js)
FIRESTORE_DATABASE_ID="ai-studio-7dc9cb2d-ccba-48fa-8d31-f2b7a4759743"

# Distributed Redis rate-limiting and job queue
# In production, mandatory for multi-instance rate limiting and 3D background worker dispatch
# REDIS_URL="rediss://default:password@my-redis-host:6379"
# RATE_LIMIT_FAIL_CLOSED="true"
