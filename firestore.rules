rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: uid (Firebase Auth UID)
    // Fields:
    //   - uid: string (required) - Firebase Auth UID
    //   - name: string (optional) - Full name
    //   - email: string (required) - Email address
    //   - phone: string (optional) - Phone number
    //   - role: string (required, enum: ['user', 'admin']) - User role
    //   - preferences: string (optional) - User property preferences
    //   - createdAt: timestamp (optional) - Account creation timestamp
    //
    // Collection: properties
    // Document ID: propertyId
    // Fields:
    //   - id: string (optional) - Property ID
    //   - title: string (required) - Property title
    //   - price: number (required) - Property price
    //   - location: string (required) - Property location
    //   - bedrooms: number (optional) - Number of bedrooms
    //   - bathrooms: number (optional) - Number of bathrooms
    //   - area: number (optional) - Area in sqm
    //   - imageUrl: string (optional) - Image URL
    //   - status: string (required, enum: ['For Sale', 'For Rent']) - Property status
    //   - isVerified: bool (optional) - Whether the property is verified
    //   - paymentMethods: list (optional) - List of payment methods
    //   - authorUid: string (optional) - UID of the user who created the listing
    //   - lifecycleStatus: string (optional, enum: ['draft', 'submitted', 'under_review', 'changes_requested', 'approved', 'published', 'viewed', 'contacted', 'reserved', 'sold', 'archived'])
    //   - granularVerification: map (optional) - Detailed compliance verification metrics
    //   - threeDTour: map (optional) - 3D reconstruction asset and waypoints
    //   - trustMatrix: map (optional) - Multi-pillar legal, licensing, financial & physical inspection matrix
    //
    // Collection: document_access_requests
    // Document ID: requestId
    // Fields:
    //   - propertyId: string (required) - Associated property ID
    //   - ownerId: string (required) - Property owner UID
    //   - requesterId: string (required) - Requesting buyer UID
    //   - requesterName: string (required) - Buyer display name
    //   - requesterPhone: string (required) - Buyer contact phone
    //   - status: string (required, enum: ['pending', 'granted', 'rejected', 'revoked', 'expired'])
    //   - requestedAt: string (required) - Timestamp of request
    //   - watermarkText: string (required) - Cryptographic / tamper-evident watermark stamp
    //   - grantedAt: string (optional) - Timestamp of owner grant
    //   - expiresAt: string (optional) - Expiration timestamp of access grant
    //
    // Collection: property_audit_logs
    // Document ID: logId
    // Fields:
    //   - propertyId: string (required) - Associated property ID
    //   - actorId: string (required) - UID of actor executing status change
    //   - actorRole: string (required) - Role of the actor
    //   - fromStatus: string (required) - Lifecycle status transitioned from
    //   - toStatus: string (required) - Lifecycle status transitioned to
    //   - timestamp: string (required) - ISO timestamp of transition
    //   - reason: string (optional) - Description / reason for transition
    //   - metadata: map (optional) - Additional operational metadata
    //
    // Collection: transactions
    // Document ID: transactionId
    // Fields:
    //   - id: string (optional) - Transaction record ID
    //   - propertyId: string (required) - Associated property ID
    //   - propertyTitle: string (optional) - Property title
    //   - buyerId: string (required) - Purchasing buyer UID
    //   - buyerName: string (optional) - Purchasing buyer display name
    //   - buyerPhone: string (optional) - Purchasing buyer contact phone
    //   - sellerId: string (required) - Property seller UID
    //   - sellerName: string (optional) - Property seller display name
    //   - agentId: string (optional) - Designated broker/agent UID
    //   - agreedPrice: number (required) - Agreed purchase price
    //   - currency: string (optional, enum: ['EGP', 'USD']) - Transaction currency
    //   - depositAmount: number (required) - Escrow deposit amount (جدية الحجز)
    //   - depositPercent: number (optional) - Percentage of price for deposit
    //   - depositStatus: string (optional, enum: ['unpaid', 'held_in_escrow', 'released_to_seller', 'refunded_to_buyer'])
    //   - paymentMethod: string (optional) - Selected payment method
    //   - escrowReference: string (optional) - Platform/CBE escrow tracking reference
    //   - status: string (required, enum: ['offer_submitted', 'counter_offered', 'offer_accepted', 'deposit_pending', 'deposit_escrowed', 'contract_drafting', 'closing_scheduled', 'completed', 'cancelled', 'refunded'])
    //   - idempotencyKey: string (required) - Unique idempotency key
    //   - contractTerms: map (optional) - Payment schedule and contingencies
    //   - closingDate: string (optional) - Real Estate Publicity Department closing timestamp
    //   - createdAt: string/timestamp (required) - Creation timestamp
    //   - updatedAt: string/timestamp (optional) - Last update timestamp
    //
    // Collection: agents
    // Document ID: agentId (Agent UID)
    // Fields:
    //   - id: string (optional) - Agent profile ID
    //   - name: string (required) - Full name
    //   - nameAr: string (optional) - Arabic display name
    //   - agencyName: string (optional) - Brokerage or agency name
    //   - licenseNumber: string (optional) - Certified broker license number
    //   - phone: string (optional) - Contact phone number
    //   - whatsapp: string (optional) - WhatsApp messaging number
    //   - email: string (optional) - Contact email address
    //   - rating: number (optional) - Agent rating (1 to 5)
    //   - reviewCount: number (optional) - Total review count
    //   - activeListingsCount: number (optional) - Count of currently managed listings
    //   - closedDealsCount: number (optional) - Count of completed transactions
    //   - specializations: list (optional) - Geographic areas or property types
    //   - verificationBadge: bool (optional) - Verified advisor status
    //   - commissionRatePercent: number (optional) - Commission rate percentage
    //
    // Collection: crm_leads
    // Document ID: leadId
    // Fields:
    //   - id: string (optional) - Lead identifier
    //   - propertyId: string (required) - Associated property listing ID
    //   - propertyTitle: string (required) - Listing headline/title
    //   - propertyLocation: string (optional) - Property location/compound
    //   - buyerId: string (optional) - Prospective buyer UID if signed in
    //   - buyerName: string (required) - Prospective buyer full name
    //   - buyerPhone: string (required) - Prospective buyer contact phone
    //   - buyerEmail: string (optional) - Prospective buyer email
    //   - assignedAgentId: string (required) - Designated broker/agent UID
    //   - assignedAgentName: string (optional) - Designated broker display name
    //   - status: string (required, enum: ['new_inquiry', 'contacted', 'viewing_scheduled', 'viewing_completed', 'negotiating', 'closed_won', 'closed_lost'])
    //   - priority: string (required, enum: ['hot', 'warm', 'cold'])
    //   - budget: number (optional) - Buyer budget
    //   - currency: string (optional, enum: ['EGP', 'USD'])
    //   - viewingAppointment: map (optional) - Scheduled viewing details (date, time, type)
    //   - notes: list (optional) - Interaction audit log & status history
    //   - createdAt: string/timestamp (required) - Lead creation timestamp
    //   - updatedAt: string/timestamp (optional) - Last modification timestamp
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      // Check the cheap, read-free super-admin allowlist FIRST so a super-admin
      // with no /users doc is still recognised. Only touch the users doc when it
      // actually exists — get() on a missing doc errors out and denies the rule.
      return isAuthenticated() &&
        (isSuperAdmin() ||
         (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'));
    }

    function isSuperAdmin() {
      // Must stay in sync with SUPER_ADMIN_EMAILS in src/constants.ts.
      return isAuthenticated() &&
        (request.auth.token.email == "marwaneltaweel0@gmail.com" ||
         request.auth.token.email == "abdallahahmedpilot2426@gmail.com" ||
         request.auth.token.email == "pro.mahmoud.h@gmail.com" ||
         request.auth.token.email == "modyhashim2006@gmail.com");
    }

    function isValidUser(data) {
      return data.keys().hasOnly(['uid', 'name', 'email', 'role', 'createdAt', 'phone', 'preferences', 'favorites', 'lastLoginAt']) &&
             data.keys().hasAll(['uid', 'email', 'role']) &&
             data.uid is string && data.uid.size() < 100 &&
             data.email is string && data.email.size() < 255 &&
             data.role in ['user', 'admin'] &&
             (!('name' in data) || (data.name is string && data.name.size() < 255)) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() < 100) || data.createdAt is timestamp) &&
             (!('phone' in data) || (data.phone is string && data.phone.size() < 50)) &&
             (!('preferences' in data) || (data.preferences is string && data.preferences.size() < 10000)) &&
             (!('favorites' in data) || (data.favorites is list && data.favorites.size() <= 100)) &&
             (!('lastLoginAt' in data) || (data.lastLoginAt is string && data.lastLoginAt.size() < 100) || data.lastLoginAt is timestamp);
    }

    function isValidProperty(data) {
      return data.keys().hasOnly(['title', 'price', 'location', 'bedrooms', 'bathrooms', 'area', 'propertyType', 'compound', 'developer', 'deliveryDate', 'finishing', 'floor', 'view', 'furnished', 'contactPhone', 'amenities', 'areaTo', 'paymentPlans', 'currency', 'pricePeriod', 'guests', 'village', 'yallaSahel', 'lat', 'lng', 'imageUrl', 'images', 'panoramas', 'videoUrl', 'digitalTwinUrl', 'status', 'availability', 'isVerified', 'verificationStatus', 'paymentMethods', 'publishDate', 'unitCode', 'legalDocs', 'authorUid', 'description', 'registrationNumber', 'courtSignatureValidity', 'isResale', 'listingState', 'verifiedBy', 'verifiedAt', 'reviewNote', 'rejectedAt',
                                 'gardenArea', 'roofArea', 'unitModel', 'buildingType', 'floorsDescription',
                                 'maintenanceFee', 'phase', 'projectAreaFeddan', 'greenSpacePercent',
                                 'financing', 'masterPlanUrl', 'floorPlanUrls', 'depthMaps',
                                 'projectPriceFrom', 'priceSource', 'priceAsOf',
                                 'lifecycleStatus', 'granularVerification', 'threeDTour', 'trustMatrix']) &&
             data.keys().hasAll(['title', 'price', 'location', 'status']) &&
             data.title is string && data.title.size() > 0 && data.title.size() < 200 &&
             data.price is number && data.price >= 0 &&
             data.location is string && data.location.size() > 0 &&
             data.status in ['For Sale', 'For Rent'] &&
             (!('availability' in data) || data.availability in ['Available', 'Sold', 'Reserved']) &&
             (!('bedrooms' in data) || data.bedrooms is number) &&
             (!('bathrooms' in data) || data.bathrooms is number) &&
             (!('area' in data) || data.area is number) &&
             (!('propertyType' in data) || (data.propertyType is string && data.propertyType.size() < 50)) &&
             (!('compound' in data) || (data.compound is string && data.compound.size() < 120)) &&
             (!('developer' in data) || (data.developer is string && data.developer.size() < 120)) &&
             (!('deliveryDate' in data) || (data.deliveryDate is string && data.deliveryDate.size() < 50)) &&
             (!('finishing' in data) || (data.finishing is string && data.finishing.size() < 50)) &&
             (!('floor' in data) || (data.floor is string && data.floor.size() < 30)) &&
             (!('view' in data) || (data.view is string && data.view.size() < 60)) &&
             (!('furnished' in data) || data.furnished is bool) &&
             (!('contactPhone' in data) || (data.contactPhone is string && data.contactPhone.size() < 30)) &&
             (!('amenities' in data) || (data.amenities is list && data.amenities.size() <= 40)) &&
             (!('areaTo' in data) || data.areaTo is number) &&
             (!('paymentPlans' in data) || (data.paymentPlans is list && data.paymentPlans.size() <= 10)) &&
             (!('currency' in data) || data.currency in ['EGP', 'USD']) &&
             (!('pricePeriod' in data) || data.pricePeriod in ['total', 'night', 'week', 'month']) &&
             (!('guests' in data) || data.guests is number) &&
             (!('village' in data) || (data.village is string && data.village.size() < 120)) &&
             (!('yallaSahel' in data) || data.yallaSahel is bool) &&
             (!('lat' in data) || data.lat is number) &&
             (!('lng' in data) || data.lng is number) &&
             (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() < 2000000)) &&
             (!('images' in data) || (data.images is list && data.images.size() <= 20)) &&
             (!('panoramas' in data) || (data.panoramas is list && data.panoramas.size() <= 20)) &&
             (!('videoUrl' in data) || (data.videoUrl is string && data.videoUrl.size() < 2000000)) &&
             (!('digitalTwinUrl' in data) || (data.digitalTwinUrl is string && data.digitalTwinUrl.size() < 2000)) &&
             (!('isVerified' in data) || data.isVerified is bool) &&
             (!('verificationStatus' in data) || data.verificationStatus in ['Pending', 'Verified', 'Rejected']) &&
             (!('paymentMethods' in data) || (data.paymentMethods is list && data.paymentMethods.size() <= 10)) &&
             (!('publishDate' in data) || (data.publishDate is string && data.publishDate.size() < 50)) &&
             (!('unitCode' in data) || (data.unitCode is string && data.unitCode.size() < 50)) &&
             (!('legalDocs' in data) || (data.legalDocs is list && data.legalDocs.size() <= 10)) &&
             (!('authorUid' in data) || data.authorUid is string) &&
             (!('description' in data) || (data.description is string && data.description.size() <= 50000)) &&
             (!('registrationNumber' in data) || (data.registrationNumber is string && data.registrationNumber.size() < 100)) &&
             (!('courtSignatureValidity' in data) || data.courtSignatureValidity is bool) &&
             (!('isResale' in data) || data.isResale is bool) &&
             (!('listingState' in data) || data.listingState in ['Draft', 'Live', 'Removed']) &&
             (!('verifiedBy' in data) || (data.verifiedBy is string && data.verifiedBy.size() < 255)) &&
             (!('verifiedAt' in data) || (data.verifiedAt is string && data.verifiedAt.size() < 50)) &&
             (!('reviewNote' in data) || (data.reviewNote is string && data.reviewNote.size() < 2000)) &&
             // Set by an admin on rejection and never writable by the owner, so a
             // pulled listing cannot quietly return to the public grid on a resubmit.
             (!('rejectedAt' in data) || (data.rejectedAt is string && data.rejectedAt.size() < 50)) &&
             (!('gardenArea' in data) || data.gardenArea is number) &&
             (!('roofArea' in data) || data.roofArea is number) &&
             (!('unitModel' in data) || (data.unitModel is string && data.unitModel.size() < 80)) &&
             (!('buildingType' in data) || (data.buildingType is string && data.buildingType.size() < 80)) &&
             (!('floorsDescription' in data) || (data.floorsDescription is string && data.floorsDescription.size() < 60)) &&
             (!('maintenanceFee' in data) || data.maintenanceFee is number) &&
             // Project-level pricing is editorial: reviewers set it, owners cannot.
             (!('projectPriceFrom' in data) || (data.projectPriceFrom is number && data.projectPriceFrom >= 0)) &&
             (!('priceSource' in data) || (data.priceSource is string && data.priceSource.size() < 200)) &&
             (!('priceAsOf' in data) || (data.priceAsOf is string && data.priceAsOf.size() < 40)) &&
             (!('phase' in data) || (data.phase is string && data.phase.size() < 80)) &&
             (!('projectAreaFeddan' in data) || data.projectAreaFeddan is number) &&
             (!('greenSpacePercent' in data) || data.greenSpacePercent is number) &&
             (!('financing' in data) || (data.financing is list && data.financing.size() <= 10)) &&
             (!('masterPlanUrl' in data) || (data.masterPlanUrl is string && data.masterPlanUrl.size() < 2000000)) &&
             (!('floorPlanUrls' in data) || (data.floorPlanUrls is list && data.floorPlanUrls.size() <= 20)) &&
             (!('depthMaps' in data) || (data.depthMaps is list && data.depthMaps.size() <= 20)) &&
             (!('lifecycleStatus' in data) || (data.lifecycleStatus is string && data.lifecycleStatus in ['draft', 'submitted', 'under_review', 'changes_requested', 'approved', 'published', 'viewed', 'contacted', 'reserved', 'sold', 'archived'])) &&
             (!('granularVerification' in data) || data.granularVerification is map) &&
             (!('threeDTour' in data) || data.threeDTour is map) &&
             (!('trustMatrix' in data) || data.trustMatrix is map);
    }

    function isValidNotification(data) {
      return data.keys().hasOnly(['userId', 'title', 'message', 'date', 'read']) &&
             data.keys().hasAll(['userId', 'title', 'message', 'date', 'read']) &&
             data.userId is string &&
             data.title is string && data.title.size() < 200 &&
             data.message is string && data.message.size() < 1000 &&
             data.date is string && data.date.size() < 50 &&
             data.read is bool;
    }

    function isValidUserDocument(data) {
      return data.keys().hasOnly(['fileId', 'name', 'type', 'status', 'uploadDate', 'accessStatus', 'size', 'content', 'ownerUid', 'storagePath',
                                 'reviewStatus', 'reviewedBy', 'reviewedAt', 'reviewNote']) &&
             data.keys().hasAll(['name', 'ownerUid', 'content']) &&
             data.name is string && data.name.size() > 0 && data.name.size() < 255 &&
             data.ownerUid is string &&
             data.content is string && data.content.size() > 0 && data.content.size() < 1048576 &&
             (!('fileId' in data) || (data.fileId is string && data.fileId.size() < 100)) &&
             (!('type' in data) || (data.type is string && data.type.size() < 50)) &&
             (!('status' in data) || (data.status is string && data.status.size() < 50)) &&
             (!('uploadDate' in data) || (data.uploadDate is string && data.uploadDate.size() < 50)) &&
             (!('accessStatus' in data) || (data.accessStatus is string && data.accessStatus.size() < 50)) &&
             (!('size' in data) || data.size is number) &&
             (!('storagePath' in data) || (data.storagePath is string && data.storagePath.size() < 1000)) &&
             (!('reviewStatus' in data) || data.reviewStatus in ['Uploaded', 'InReview', 'Checked', 'NeedsAttention']) &&
             (!('reviewedBy' in data) || (data.reviewedBy is string && data.reviewedBy.size() < 255)) &&
             (!('reviewedAt' in data) || (data.reviewedAt is string && data.reviewedAt.size() < 50)) &&
             (!('reviewNote' in data) || (data.reviewNote is string && data.reviewNote.size() < 2000));
    }

    function isValidChatSession(data) {
      return data.keys().hasOnly(['id', 'userId', 'title', 'messages', 'lastUpdatedAt']) &&
             data.keys().hasAll(['userId', 'title', 'messages']) &&
             data.userId is string &&
             data.title is string && data.title.size() < 500 &&
             data.messages is list && data.messages.size() <= 200 &&
             (!('lastUpdatedAt' in data) || data.lastUpdatedAt is string || data.lastUpdatedAt is timestamp);
    }

    function uidNotModified() {
      return !('uid' in request.resource.data) || request.resource.data.uid == resource.data.uid;
    }

    function ownerUidNotModified() {
      return !('ownerUid' in request.resource.data) || request.resource.data.ownerUid == resource.data.ownerUid;
    }

    // What a listing's own author may write. Deliberately excludes authorUid,
    // publishDate, unitCode, verifiedBy, verifiedAt and reviewNote — those belong
    // to the platform, not to the seller.
    function ownerEditableListingKeys() {
      // lat/lng are deliberately absent: the wizard never writes them, and moving
      // a reviewed listing's pin to another governorate is not a cosmetic edit.
      return ['title', 'description', 'price', 'currency', 'location',
              'bedrooms', 'bathrooms', 'area', 'areaTo', 'propertyType', 'compound',
              'developer', 'deliveryDate', 'finishing', 'floor', 'view', 'furnished',
              'contactPhone', 'amenities', 'paymentPlans', 'paymentMethods',
              'pricePeriod', 'guests', 'village', 'yallaSahel', 'imageUrl', 'images',
              'panoramas', 'videoUrl', 'digitalTwinUrl', 'status', 'availability',
              'legalDocs', 'registrationNumber', 'courtSignatureValidity', 'isResale',
              'listingState', 'isVerified', 'verificationStatus',
              'gardenArea', 'roofArea', 'unitModel', 'buildingType', 'floorsDescription',
              'maintenanceFee', 'phase', 'projectAreaFeddan', 'greenSpacePercent',
              'financing', 'masterPlanUrl', 'floorPlanUrls', 'depthMaps',
              'lifecycleStatus', 'threeDTour'];
    }

    // Changing any of these invalidates whatever a reviewer previously saw, so the
    // same write must drop the listing back to Pending. contactPhone is in the list
    // on purpose: swapping the number on a reviewed listing is the classic switch.
    function materialListingKeys() {
      return ['title', 'price', 'currency', 'location', 'area', 'areaTo', 'status',
              'propertyType', 'compound', 'developer', 'contactPhone', 'legalDocs',
              'registrationNumber', 'courtSignatureValidity', 'isResale',
              // Sold-on area and the fees attached to the price: same class as price.
              'gardenArea', 'roofArea', 'maintenanceFee'];
    }

    function listingChangedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function isValidOwnerLifecycleTransition(fromStatus, toStatus) {
      return toStatus == 'archived' ||
             (fromStatus == 'draft' && toStatus == 'submitted') ||
             (fromStatus == 'submitted' && toStatus == 'draft') ||
             (fromStatus == 'changes_requested' && (toStatus == 'submitted' || toStatus == 'draft')) ||
             (fromStatus == 'archived' && toStatus == 'draft');
    }

    function isValidPropertyAuditLog(data) {
      return data.keys().hasAll(['propertyId', 'actorId', 'actorRole', 'fromStatus', 'toStatus', 'timestamp']) &&
             data.propertyId is string && data.propertyId.size() > 0 && data.propertyId.size() < 100 &&
             data.actorId is string && data.actorId.size() > 0 && data.actorId.size() < 100 &&
             data.actorRole is string && data.actorRole.size() < 50 &&
             data.fromStatus is string && data.fromStatus.size() < 50 &&
             data.toStatus is string && data.toStatus.size() < 50 &&
             (data.timestamp is string || data.timestamp is timestamp) &&
             (!('id' in data) || (data.id is string && data.id.size() < 100)) &&
             (!('actorEmail' in data) || (data.actorEmail is string && data.actorEmail.size() < 255)) &&
             (!('reason' in data) || (data.reason is string && data.reason.size() < 2000)) &&
             (!('metadata' in data) || data.metadata is map);
    }

    // ===============================================================
    // Match Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isAuthenticated() && isOwner(userId) && isValidUser(request.resource.data) && (request.resource.data.role == 'user' || isSuperAdmin());
      // Owners edit their own profile (but can't self-promote); admins manage any user.
      allow update: if isValidUser(request.resource.data) && uidNotModified() && (
                      (isOwner(userId) && (request.resource.data.role == resource.data.role || isSuperAdmin())) ||
                      isAdmin()
                    );
      allow delete: if isAdmin();
    }

    match /properties/{propertyId} {
      allow read: if (resource.data.get('lifecycleStatus', 'published') == 'published' && resource.data.get('listingState', 'Live') == 'Live')
                  || (isAuthenticated() && (resource.data.get('authorUid', '') == request.auth.uid || isAdmin()));
      // Admins create anything; any authenticated user may submit their OWN
      // listing for review, but only as an unverified "Pending" entry.
      allow create: if isValidProperty(request.resource.data) && (
                      isAdmin() ||
                      (isAuthenticated()
                        && request.resource.data.authorUid == request.auth.uid
                        && request.resource.data.verificationStatus == 'Pending'
                        && request.resource.data.isVerified == false
                        // The audit trail is the platform's. Without this a seller
                        // can create a listing already carrying a fabricated
                        // reviewer and timestamp, which they then cannot remove.
                        && !request.resource.data.keys().hasAny(['verifiedBy', 'verifiedAt', 'reviewNote', 'rejectedAt'])
                        && (!('lifecycleStatus' in request.resource.data) || request.resource.data.lifecycleStatus in ['draft', 'submitted']))
                    );
      // Admins edit anything. A listing's own author may edit their own listing,
      // but only the fields above, and never upward: touching a material field
      // forces verification back to Pending in the SAME write, so there is no
      // sequence of writes that leaves an edited listing wearing an old badge.
      allow update: if isValidProperty(request.resource.data) && (
                      isAdmin() ||
                      ( isAuthenticated()
                        // gate on the STORED author, never the submitted one —
                        // otherwise anyone could seize a listing by writing their uid
                        && resource.data.get('authorUid', '') == request.auth.uid
                        && 'authorUid' in request.resource.data
                        && request.resource.data.authorUid == resource.data.authorUid
                        && listingChangedKeys().hasOnly(ownerEditableListingKeys())
                        && ( listingChangedKeys().hasAny(materialListingKeys())
                             ? ( request.resource.data.get('verificationStatus', '') == 'Pending'
                                  && request.resource.data.get('isVerified', true) == false )
                             : ( request.resource.data.get('verificationStatus', 'Pending')
                                   == resource.data.get('verificationStatus', 'Pending')
                                 && request.resource.data.get('isVerified', false)
                                   == resource.data.get('isVerified', false) )
                            )
                        && ( !listingChangedKeys().hasAny(['lifecycleStatus'])
                             || request.resource.data.get('lifecycleStatus', '') == resource.data.get('lifecycleStatus', '')
                             || isValidOwnerLifecycleTransition(resource.data.get('lifecycleStatus', 'draft'), request.resource.data.lifecycleStatus) )
                      )
                    );
      allow delete: if isAdmin()
                    || (isAuthenticated() && resource.data.get('authorUid', '') == request.auth.uid);
    }

    match /property_audit_logs/{logId} {
      allow read: if isAuthenticated() && (resource.data.actorId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated()
                    && request.resource.data.actorId == request.auth.uid
                    && request.resource.data.keys().hasAll(['propertyId', 'actorId', 'actorRole', 'fromStatus', 'toStatus', 'timestamp'])
                    && isValidPropertyAuditLog(request.resource.data);
      allow update, delete: if false;
    }

    match /user_documents/{docId} {
      allow read, delete: if isAuthenticated() && (resource.data.ownerUid == request.auth.uid || isAdmin());
      // A document arrives unreviewed and cannot arrive any other way. The legacy
      // self-asserted 'status' field is banned on create so nobody can mint their
      // own "Verified" the way the old client did.
      allow create: if isAuthenticated()
                    && request.resource.data.ownerUid == request.auth.uid
                    && isValidUserDocument(request.resource.data)
                    && request.resource.data.get('reviewStatus', 'Uploaded') == 'Uploaded'
                    && !request.resource.data.keys().hasAny(['status', 'reviewedBy', 'reviewedAt', 'reviewNote']);
      // Only a reviewer decides a verdict. The owner may rename their file and
      // nothing else — to fix a problem they delete and re-upload.
      allow update: if isValidUserDocument(request.resource.data)
                    && ownerUidNotModified()
                    && (
                      isAdmin() ||
                      ( isAuthenticated()
                        && resource.data.ownerUid == request.auth.uid
                        && (
                          // Rename, and nothing else.
                          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
                          ||
                          // Or ask for a review. Only from no state at all, and only
                          // to 'Uploaded' — a document predating reviewStatus is
                          // invisible to the admin queue otherwise. Every other
                          // value stays a reviewer's decision.
                          ( request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reviewStatus'])
                            && !('reviewStatus' in resource.data)
                            && request.resource.data.reviewStatus == 'Uploaded'
                          )
                        )
                      )
                    );
    }

    match /document_access_requests/{requestId} {
      allow read: if isAuthenticated() && (resource.data.requesterId == request.auth.uid || resource.data.ownerId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated()
                    && request.resource.data.requesterId == request.auth.uid
                    && request.resource.data.keys().hasAll(['propertyId', 'ownerId', 'requesterId', 'requesterName', 'requesterPhone', 'status', 'requestedAt', 'watermarkText'])
                    && request.resource.data.status == 'pending';
      allow update: if isAuthenticated() && (
                      isAdmin() ||
                      (resource.data.ownerId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'grantedAt', 'expiresAt']))
                    );
      allow delete: if isAdmin();
    }

    match /transactions/{transactionId} {
      allow read: if isAuthenticated() && (
        resource.data.buyerId == request.auth.uid ||
        resource.data.sellerId == request.auth.uid ||
        ('agentId' in resource.data && resource.data.agentId == request.auth.uid) ||
        isAdmin()
      );
      allow create: if isAuthenticated()
                    && request.resource.data.buyerId == request.auth.uid
                    && request.resource.data.buyerId != request.resource.data.sellerId
                    && request.resource.data.keys().hasAll(['propertyId', 'buyerId', 'sellerId', 'agreedPrice', 'depositAmount', 'status', 'idempotencyKey', 'createdAt'])
                    && request.resource.data.agreedPrice > 0
                    && request.resource.data.status in ['offer_submitted', 'offer_accepted'];
      allow update: if isAuthenticated() && (
                      isAdmin() ||
                      (resource.data.buyerId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'depositStatus', 'paymentMethod', 'escrowReference', 'updatedAt'])) ||
                      (resource.data.sellerId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']))
                    );
      allow delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      // Admins notify anyone; a signed-in user may only create a notification
      // addressed to themselves (e.g. their own purchase confirmation).
      allow create: if isValidNotification(request.resource.data) && (
                      isAdmin() ||
                      (isAuthenticated() && request.resource.data.userId == request.auth.uid)
                    );
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && isValidNotification(request.resource.data) && request.resource.data.userId == resource.data.userId;
      allow delete: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();
    }

    match /chat_sessions/{sessionId} {
      allow read, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow list: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid && isValidChatSession(request.resource.data);
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && isValidChatSession(request.resource.data) && request.resource.data.userId == resource.data.userId;
    }

    match /purchases/{purchaseId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Listing abuse reports — anyone signed in can file one; only admins read/act.
    match /reports/{reportId} {
      allow read, list, update, delete: if isAdmin();
      allow create: if isAuthenticated()
                    && request.resource.data.keys().hasOnly(['propertyId', 'userId', 'reason', 'createdAt'])
                    && request.resource.data.propertyId is string
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.reason is string && request.resource.data.reason.size() < 1000;
    }

    // Contact-form messages — anyone (incl. signed-out visitors) may send one;
    // only admins can read or clear them.
    match /contactMessages/{msgId} {
      allow read, list, update, delete: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['email', 'message', 'createdAt', 'userId'])
                    && request.resource.data.email is string
                    && request.resource.data.email.size() > 3 && request.resource.data.email.size() < 200
                    && request.resource.data.message is string
                    && request.resource.data.message.size() > 0 && request.resource.data.message.size() < 5000;
    }

    // Saved-search email alerts — a signed-in user subscribes; admins/functions read.
    match /alertSubscriptions/{subId} {
      allow read, list, delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated()
                    && request.resource.data.keys().hasOnly(['userId', 'email', 'q', 'minPrice', 'maxPrice', 'typeFilter', 'createdAt'])
                    && request.resource.data.userId == request.auth.uid
                    // Only your own verified account email — can't sign the platform up to spam a stranger.
                    && request.resource.data.email == request.auth.token.email
                    && request.resource.data.email is string && request.resource.data.email.size() < 200;
    }

    // Property reviews — public to read; signed-in users post one; author or admin deletes.
    match /reviews/{reviewId} {
      allow read, list: if true;
      allow create: if isAuthenticated()
                    && request.resource.data.keys().hasOnly(['propertyId', 'userId', 'userName', 'rating', 'comment', 'createdAt'])
                    && request.resource.data.propertyId is string
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.rating is number
                    && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
                    && request.resource.data.comment is string && request.resource.data.comment.size() < 1000;
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    // Phase 8: Agent Ecosystem & Broker Profiles
    match /agents/{agentId} {
      allow read: if true; // Public agent directories / broker profiles
      allow create, update: if isAuthenticated() && (request.auth.uid == agentId || isAdmin());
      allow delete: if isAdmin();
    }

    // Phase 9: Broker CRM Leads Pipeline & Viewing Management
    match /crm_leads/{leadId} {
      allow read: if isAuthenticated() && (
        resource.data.assignedAgentId == request.auth.uid ||
        ('buyerId' in resource.data && resource.data.buyerId == request.auth.uid) ||
        isAdmin()
      );
      allow create: if isAuthenticated() &&
                    request.resource.data.keys().hasAll(['propertyId', 'propertyTitle', 'buyerName', 'buyerPhone', 'assignedAgentId', 'status', 'priority', 'createdAt']) &&
                    request.resource.data.status in ['new_inquiry', 'contacted'];
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (resource.data.assignedAgentId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'priority', 'viewingAppointment', 'notes', 'updatedAt']))
      );
      allow delete: if isAdmin();
    }
  }
}
